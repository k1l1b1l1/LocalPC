[Unit]
Description=EGO runtime recorder (Raspberry Pi 5)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

# Prefer unit generated by ./install.sh → var/ego-runtime.service (local paths).
# This file is a legacy template.

[Service]
Type=simple
ExecStart=/usr/local/bin/ego-runtime run --config /etc/ego-runtime/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
