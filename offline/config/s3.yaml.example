# S3 upload (Timeweb Cloud — https://timeweb.cloud/docs/s3-storage/manage-storage/s3-guide)
# Copy to config/s3.local.yaml for secrets (gitignored), or use env EGO_S3_ACCESS_KEY / EGO_S3_SECRET_KEY
# Requires curl with --aws-sigv4 (curl 7.75+). RPi: sudo apt install curl openssl

s3:
  enabled: true
  endpoint: "https://s3.twcstorage.ru"
  region: "ru-1"
  bucket: "your-bucket-id"
  prefix: "ego-sessions"
  path_style: true
  access_key_env: "EGO_S3_ACCESS_KEY"
  secret_key_env: "EGO_S3_SECRET_KEY"
  require_pipeline_success: false
  require_real_mdf4: true
  include_session_files: false
  max_retries: 5
  retry_backoff_ms: 1000
